<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">

    <!-- TITLE -->

    <top>
        <Label style="-fx-font-size: 24px;                       -fx-font-weight: bold;                       -fx-padding: 20px;" text="Farm Dashboard" />
    </top>


    <!-- MAIN CONTENT -->

    <center>

        <VBox fx:id="mainVBox" spacing="15.0">

            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>


            <!-- TASK ENTRY -->

            <Label style="-fx-font-size: 16px;                           -fx-font-weight: bold;" text="Messages" />


            <HBox spacing="10.0">

                <ComboBox fx:id="priorityCombo" prefWidth="130.0" promptText="Priority" />

                <Button onAction="#handleAdd" style="-fx-background-color: lightgreen;" text="Select" />
            <TextArea fx:id="messagesArea" prefHeight="37.0" prefWidth="280.0" />

            </HBox>


            <!-- TASK LIST -->

            <Label style="-fx-font-size: 16px;                           -fx-font-weight: bold;" text="Farm Items" />
         <TextField fx:id="taskField" promptText="Enter farm item..." />

            <ListView fx:id="taskList" prefHeight="220.0" />


            <!-- BUTTONS -->

            <HBox spacing="10.0">

                <Button onAction="#handleComplete" text="Delete" />

                <Button onAction="#handleClear" style="-fx-background-color: lightcoral;" text="Change Color" />
            <ComboBox fx:id="colorCombo" prefWidth="150.0" promptText="White" />

            </HBox>

        </VBox>

    </center>

</BorderPane>
